# =============================================================================
# InfoSociety - Society Banking Software
# Copy this file to .env and fill in your values
# =============================================================================

# Django Core (DJANGO_SETTINGS_MODULE is set in manage.py / wsgi.py, not here)
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# =============================================================================
# Database (PostgreSQL - required for django-tenants)
# =============================================================================
DB_NAME=society_software
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# Redis (Celery broker for background tasks: day-end, interest calc, reports)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AWS S3 (production media storage: member photos, documents, receipts)
# Leave empty for local dev - uses filesystem storage
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# =============================================================================
# Email (console backend in dev; SMTP in production for notifications)
# =============================================================================
EMAIL_HOST=localhost
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=noreply@infosociety.in

# =============================================================================
# SMS Gateway (bulk SMS for member notifications, OTPs, reminders)
# =============================================================================
SMS_API_KEY=
SMS_SENDER_ID=SOCSFT

# =============================================================================
# Razorpay (SaaS subscription billing for societies)
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =============================================================================
# WhatsApp Business API (optional: collection reminders, EMI alerts)
# =============================================================================
WHATSAPP_API_KEY=
WHATSAPP_SENDER=

# =============================================================================
# Financial Year Configuration
# =============================================================================
FINANCIAL_YEAR_START_MONTH=4
FINANCIAL_YEAR_START_DAY=1

# =============================================================================
# Society Defaults (used during tenant onboarding)
# =============================================================================
DEFAULT_SHARE_FACE_VALUE=100.00
DEFAULT_MAX_SHARES_PER_MEMBER=100
DEFAULT_MIN_SHARES_REQUIRED=1
DEFAULT_PENAL_INTEREST_RATE=3.00
DEFAULT_PENAL_CHARGE_AFTER_DAYS=45
DEFAULT_MAX_GUARANTEES_PER_PERSON=2
DEFAULT_NPA_DAYS_THRESHOLD=90

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FILE=logs/society_software.log

# =============================================================================
# Security (production overrides)
# =============================================================================
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SESSION_COOKIE_AGE=28800
